{
  "name": "@kobrax/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:rebuild": "tsx prisma/rebuild.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:catalog": "tsx prisma/seed.ts --catalog",
    "db:seed:refresh": "tsx prisma/seed.ts --refresh",
    "db:verify:seed": "prisma db execute --file prisma/verify/seed-sin-caso.sql --schema prisma/schema.prisma",
    "db:verify:contraccion": "prisma db execute --file prisma/verify/sin-caso-contraccion.sql --schema prisma/schema.prisma",
    "db:audit:psf": "tsx prisma/audit-psf.ts",
    "db:audit:assignments": "tsx prisma/audit-assignments.ts",
    "db:studio": "prisma studio",
    "db:backfill:catalogs": "tsx prisma/backfill-catalogs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@kobrax/shared": "workspace:*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
