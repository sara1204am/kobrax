# Los scripts que corren en el servidor SIEMPRE se guardan con fin de linea LF.
# Con CRLF, bash falla con "\r: command not found" — un error que no dice nada
# sobre su causa y que solo aparece en produccion, nunca en la maquina Windows
# donde se escribio el archivo.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
Caddyfile text eol=lf

# Los PDF son binarios: con autocrlf, git les cambiaba los saltos de linea al hacer checkout y los
# rompia (los reportes de docs/flows son fixtures de los tests del importador).
*.pdf binary
