# ── Base de datos ────────────────────────────────────────────────
# DATABASE_URL: usada por migraciones/seed/studio. Conecta como superuser en dev.
# Puerto 5434: el contenedor docker se publica ahí (5432/5433 pueden tener PG nativos).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/kobrax?schema=public"
# APP_DATABASE_URL: usada por la API en runtime. Rol kobrax_app (NOBYPASSRLS) →
# queda sujeto al aislamiento multi-tenant por RLS. NUNCA usar el superuser aquí.
APP_DATABASE_URL="postgresql://kobrax_app:kobrax_app_pwd@127.0.0.1:5434/kobrax?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Auth / JWT ───────────────────────────────────────────────────
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Storage (evidencia: fotos, firmas) ───────────────────────────
S3_BUCKET="kobrax-evidence"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ── App ──────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_PORT="4010"
MOBILE_APP_SCHEME="kobrax"
SOCKET_CORS_ORIGIN="http://localhost:3000"

# ── Cifrado a nivel aplicación (AES-256-GCM datos sensibles) ─────
APP_ENCRYPTION_KEY=""
# Blind index (HMAC-SHA256) para buscar/deduplicar documentos cifrados (F4). 32 bytes hex, DISTINTA de APP_ENCRYPTION_KEY.
APP_BLIND_INDEX_KEY=""
