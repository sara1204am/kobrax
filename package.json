{
  "name": "kobrax",
  "version": "0.1.0",
  "private": true,
  "description": "Kobrax — Plataforma multi-tenant de gestión inteligente de cobranzas",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @kobrax/database prisma generate",
    "db:migrate": "pnpm --filter @kobrax/database prisma migrate dev",
    "db:deploy": "pnpm --filter @kobrax/database prisma migrate deploy",
    "db:reset": "pnpm --filter @kobrax/database prisma migrate reset",
    "db:seed": "pnpm --filter @kobrax/database db:seed",
    "db:seed:legal": "pnpm --filter @kobrax/database db:seed:legal",
    "db:studio": "pnpm --filter @kobrax/database prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "proxy-addr@<2.0.8": "^2.0.8",
      "multer@<2.5.0": "^2.5.0",
      "socket.io-parser@<4.2.7": "^4.2.7",
      "engine.io@<6.6.10": "^6.6.10",
      "body-parser@<1.20.9": "^1.20.9",
      "qs@<6.16.1": "^6.16.1",
      "pdfjs-dist@<6.2.108": "^6.2.108",
      "lodash@<4.18.1": "^4.18.1",
      "brace-expansion@1.x": "^1.1.22",
      "brace-expansion@2.x": "^2.1.8",
      "file-type@<20.5.0": "^20.5.0",
      "maplibre-gl@<6.4.1": "^6.4.1",
      "postcss@<8.5.23": "^8.5.23"
    }
  }
}
